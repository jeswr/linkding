{
  "name": "linkding-solid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linkding UX, pod-backed — a thin Solid SPA that does Linkding's bookmark CRUD directly against pod LDP resources instead of Django's /api/bookmarks/.",
  "license": "MIT",
  "author": "Jesse Wright",
  "scripts": {
    "dev": "vite",
    "gen-federation": "node scripts/gen-federation.mjs",
    "build": "npm run gen-federation && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jeswr/app-shell": "github:jeswr/app-shell#main",
    "@jeswr/fetch-rdf": "^0.1.0",
    "@jeswr/federation-registry": "github:jeswr/federation-registry#main",
    "@jeswr/solid-bookmark": "github:jeswr/solid-bookmark#main",
    "@jeswr/solid-session-restore": "github:jeswr/solid-session-restore#main",
    "@solid/reactive-authentication": "0.1.3",
    "n3": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/n3": "^1.26.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
